# Create discordBot/.env locally or export these variables in your shell.
# Never commit the real token or password.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Optional: while developing, guild commands update immediately in this server.
# Leave unset to register commands globally (global updates can take longer).
DISCORD_GUILD_ID=

LAVALINK_URI=ws://localhost:2333
LAVALINK_PASSWORD=replace-with-a-long-random-password

# Disconnect after this many idle minutes. Range: 1-60.
BOT_IDLE_MINUTES=5
